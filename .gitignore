# Descomentar si cada miembro del equipo usa su propia configuración
# .firebaserc

# Archivos generados por Firebase CLI
firebase-export-*.json

# Emulador storage
functions/lib/
# Nota: .firebaserc está comentado porque se recomienda que todo el equipo
# use el mismo proyecto. Si necesitas un proyecto personal, descomenta la línea.

